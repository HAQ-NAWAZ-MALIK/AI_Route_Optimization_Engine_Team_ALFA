# Dependencies (installed in Docker)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (generated in Docker)
.next
out
dist
build

# Git
.git
.gitignore

# Environment files (use Docker env vars instead)
.env*.local

# IDE
.vscode
.idea

# Docker files (not needed in image)
Dockerfile*
