# ============================================================================
# EXISTING VARIABLES
# ============================================================================
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
TOMTOM_API_KEY=your_tomtom_key_here
OSRM_SERVER_URL=https://router.project-osrm.org

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string (RECOMMENDED)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/transport_optimizer"

# For development, you can use SQLite:
# DATABASE_URL="file:./dev.db"

# ============================================================================
# AUTHENTICATION (NextAuth.js v5)
# ============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# Your application URL
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================================================
# EMAIL SERVICE
# ============================================================================
# Resend API (Recommended for Next.js)
# Get your key at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here

# Email "from" address
EMAIL_FROM=noreply@yourdomain.com

# Alternative: Standard SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# STRIPE BILLING
# ============================================================================
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe webhook secret (from: https://dashboard.stripe.com/webhooks)
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe dashboard)
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_price_id

# ============================================================================
# MCP SERVER
# ============================================================================
MCP_API_KEYS=mcp_key_1,mcp_key_2,mcp_key_3
MCP_REQUIRE_AUTH=true
MCP_HTTP_PORT=3001
MCP_HTTP_HOST=localhost
MCP_ENABLE_CORS=true
MCP_CORS_ORIGINS=https://chat.openai.com,https://claude.ai

# ============================================================================
# RATE LIMITING
# ============================================================================
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MINUTES=15

# ============================================================================
# OPTIMIZATION LIMITS
# ============================================================================
MAX_LOCATIONS=100
MAX_CABS=50
OPTIMIZATION_TIMEOUT=30000

# ============================================================================
# MONITORING & ANALYTICS (Optional)
# ============================================================================
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# PostHog for product analytics
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
