# MCP Server Configuration
# Copy this file to .env and configure

# ============================================================================
# SECURITY - API Authentication
# ============================================================================
# API keys for authentication (comma-separated for multiple keys)
MCP_API_KEYS=your-secret-api-key-here,another-key-if-needed

# Enable/disable authentication (set to 'false' for development only)
MCP_REQUIRE_AUTH=true

# ============================================================================
# HTTP SERVER (Optional - only needed for remote access)
# ============================================================================
# HTTP server port
MCP_HTTP_PORT=3001

# HTTP server host
MCP_HTTP_HOST=localhost

# Enable CORS (required for web-based LLM clients)
MCP_ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
MCP_CORS_ORIGINS=https://chat.openai.com,https://claude.ai

# ============================================================================
# ROUTING SERVICES
# ============================================================================
# OSRM server URL (leave empty to use public server)
OSRM_SERVER_URL=https://router.project-osrm.org

# Mapbox token (optional, for Mapbox Directions API)
NEXT_PUBLIC_MAPBOX_TOKEN=

# TomTom API key (optional, for traffic data)
TOMTOM_API_KEY=

# ============================================================================
# OPTIMIZATION SETTINGS
# ============================================================================
# Maximum locations per route optimization
MAX_LOCATIONS=100

# Maximum cabs for multi-cluster optimization
MAX_CABS=50

# Default optimization timeout (milliseconds)
OPTIMIZATION_TIMEOUT=30000

# ============================================================================
# RATE LIMITING (HTTP only)
# ============================================================================
# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Max requests per window
RATE_LIMIT_MAX=100

# Rate limit window (minutes)
RATE_LIMIT_WINDOW_MINUTES=15

# ============================================================================
# LOGGING
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable request/response logging
LOG_REQUESTS=true
